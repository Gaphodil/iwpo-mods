{
  "comment": "This mod allows IWPO names to be opaque (default), faded, or hidden. Fully replaces onlinePlayerDraw.gml. (Keybind ignored in GMS due to bug in GMS converter. Hooks with arguments are required in all mods for GM8.2 compatibility.)",
  "additional_code": [
    {
      "occurrence": "pre",
      "event": "worldCreate",
      "code": "@text_mode=0; @text_timer=0;"
    },
    {
      "occurrence": "post",
      "event": "worldCreate",
      "codeFile": "name_opacity/postWorldCreate.gml"
    },
    {
      "occurrence": "post",
      "event": "worldEndStep",
      "codeFile": "name_opacity/postWorldEndStep.gml"
    },
    {
      "occurrence": "pre",
      "event": "onlinePlayerDraw",
      "codeFile": "name_opacity/onlinePlayerDraw.gml"
    },
    {
      "occurrence": "pre",
      "event": "gameEnd",
      "codeFile": "name_opacity/preGameEnd.gml"
    },
    {
      "occurrence": "pre",
      "event": "worldGameEnd",
      "codeFile": "name_opacity/preWorldGameEnd.gml"
    }
  ],
  "hooks": {
    "OnUpdatePlayerCount": {
      "code": "_ = argument0;"
    },
    "OnTcpReceived": {
      "code": "_ = argument0; _ = argument1;"
    },
    "OnUdpReceived": {
      "code": "_ = argument0; _ = argument1;"
    },
    "OnPlayerMovedSending": {
      "code": "_ = argument0; _ = argument1;"
    },
    "OnPlayerMovedReceiving": {
      "code": "_ = argument0; _ = argument1;"
    }
  },
  "keybinds": ["toggle_name_visibility=u"]
}
